# Backend: any OpenAI-compatible /chat/completions endpoint.
# Ollama (default):   TMTRANS_BASE_URL=http://localhost:11434/v1
# vLLM:               TMTRANS_BASE_URL=http://localhost:8000/v1
# LM Studio:          TMTRANS_BASE_URL=http://localhost:1234/v1
# Hosted OpenAI:      TMTRANS_BASE_URL=https://api.openai.com/v1  (+ TMTRANS_API_KEY)
TMTRANS_BACKEND=openai_compat
TMTRANS_BASE_URL=http://localhost:11434/v1
TMTRANS_MODEL=qwen2.5:7b-instruct
TMTRANS_API_KEY=
TMTRANS_TEMPERATURE=0.1

# Offline dry-run / test mode (no model needed):
# TMTRANS_BACKEND=mock

# OCR backend (manuscript scans). Defaults to the translation endpoint URL.
# Serve a vision model with vLLM:  vllm serve Qwen/Qwen2.5-VL-7B-Instruct --max-model-len 16384
TMTRANS_OCR_BACKEND=vlm
TMTRANS_OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# TMTRANS_OCR_BASE_URL=http://localhost:8000/v1
# TMTRANS_OCR_API_KEY=
# Offline: TMTRANS_OCR_BACKEND=mock

# Optional: NLLB-200 dedicated translation model (NON-COMMERCIAL, CC-BY-NC-4.0).
# Install first: pip install 'tmtrans[nllb]'
# TMTRANS_BACKEND=nllb
# TMTRANS_NLLB_MODEL=facebook/nllb-200-3.3B
# TMTRANS_SRC_LANG=zho_Hans      # FLORES-200 code of the source (lzh->zho_Hans, th->tha_Thai, sa->san_Deva...)
# TMTRANS_TGT_LANG=eng_Latn
