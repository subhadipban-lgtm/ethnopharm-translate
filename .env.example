# Backend: any OpenAI-compatible /chat/completions endpoint.
# Ollama (default):   TMTRANS_BASE_URL=http://localhost:11434/v1
# vLLM:               TMTRANS_BASE_URL=http://localhost:8000/v1
# LM Studio:          TMTRANS_BASE_URL=http://localhost:1234/v1
# Hosted OpenAI:      TMTRANS_BASE_URL=https://api.openai.com/v1  (+ TMTRANS_API_KEY)
TMTRANS_BACKEND=openai_compat
TMTRANS_BASE_URL=http://localhost:11434/v1
TMTRANS_MODEL=qwen2.5:7b-instruct
TMTRANS_API_KEY=
TMTRANS_TEMPERATURE=0.1

# Offline dry-run / test mode (no model needed):
# TMTRANS_BACKEND=mock
