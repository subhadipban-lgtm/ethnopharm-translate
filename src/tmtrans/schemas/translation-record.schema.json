{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethnopharm-translate/schemas/translation-record.schema.json",
  "title": "Traditional medicine translation record",
  "type": "object",
  "required": ["document_id", "title", "source_language", "target_language", "segments"],
  "properties": {
    "document_id": { "type": "string" },
    "title": { "type": "string" },
    "source_language": { "type": "string", "description": "ISO 639 code (zh, lzh, sa, hi, ta, th, km, lo, my, vi, id, ms, tl, pi)" },
    "target_language": { "type": "string", "const": "en" },
    "variant": { "type": ["string", "null"], "enum": ["classical", "modern", null] },
    "tradition": { "type": ["string", "null"], "description": "tcm | ayurveda | se-asian | ..." },
    "source_file": { "type": ["string", "null"] },
    "created_at": { "type": "number" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "index", "source_text", "translation", "status"],
        "properties": {
          "segment_id": { "type": "string" },
          "index": { "type": "integer" },
          "source_text": { "type": "string" },
          "modern_text": { "type": ["string", "null"], "description": "classical-to-modern intermediate, if the classical stage ran" },
          "translation": { "type": "string" },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "english", "status"],
              "properties": {
                "source": { "type": "string" },
                "english": { "type": "string" },
                "binomial": { "type": "string" },
                "entry_id": { "type": "string" },
                "status": { "type": "string", "enum": ["matched", "unmatched"] }
              }
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["auto_pass", "needs_review", "failed"] },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["gate", "passed", "severity"],
                  "properties": {
                    "gate": { "type": "string" },
                    "passed": { "type": "boolean" },
                    "severity": { "type": "string", "enum": ["error", "warning", "info"] },
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          },
          "status": { "type": "string", "enum": ["auto_pass", "needs_review", "approved", "failed"] },
          "reviewed_by": { "type": ["string", "null"] },
          "reviewed_at": { "type": ["number", "null"] },
          "source_location": {
            "type": "object",
            "properties": {
              "start": { "type": ["integer", "null"] },
              "end": { "type": ["integer", "null"] },
              "page": { "type": ["integer", "null"] }
            }
          }
        }
      }
    }
  }
}
